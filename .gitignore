## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results - Ignore at any level
**/[Dd]ebug/
**/[Dd]ebugPublic/
**/[Rr]elease/
**/[Rr]eleases/
**/x64/
**/x86/
**/[Ww][Ii][Nn]32/
**/[Aa][Rr][Mm]/
**/[Aa][Rr][Mm]64/
**/bld/
**/[Bb]in/
**/bin/
**/[Oo]bj/
**/obj/
**/[Ll]og/
**/[Ll]ogs/

# Visual Studio - Ignore at any level
**/.vs/
.vs/
*.vsidx
*.vspscc
*.vsp
*.vspx

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
*.local

# Azure Functions
local.settings.json
__azurite_*
__blobstorage__
__queuestorage__
__azurite_db_*.json

# Environment files
.env
.env.local
.env.production
.env.development
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database
*.mdf
*.ldf
*.ndf

# Docker
docker-compose.override.yml

# Logs
*.log
logs/
